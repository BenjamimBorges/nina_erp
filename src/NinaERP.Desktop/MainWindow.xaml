<Window x:Class="NinaERP.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Nina ERP" Width="1366" Height="850" MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#0F172A">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="#0F172A" Padding="12,0">
            <DockPanel LastChildFill="True">
                <TextBlock Text="Nina ERP" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="14"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="StatusText" Text="Conectando..." Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="Servidor" Width="82" Height="28" Margin="0,0,8,0" Click="Settings_Click"/>
                    <Button Content="Recarregar" Width="82" Height="28" Click="Reload_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="Browser" Visibility="Collapsed"/>
            <Border x:Name="OfflinePanel" Background="#F8FAFC">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                    <TextBlock Text="Nina ERP" FontSize="34" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="OfflineMessage" Margin="0,14,0,20" FontSize="15" Foreground="#475569" TextAlignment="Center" TextWrapping="Wrap"
                               Text="Não foi possível conectar ao servidor."/>
                    <Button Content="Tentar novamente" Width="150" Height="38" Click="Retry_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
