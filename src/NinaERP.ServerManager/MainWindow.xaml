<Window x:Class="NinaERP.ServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nina ERP • Server Manager" Width="920" Height="760" MinWidth="820" MinHeight="690"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <StackPanel>
                <TextBlock Text="Nina ERP Server Manager" FontSize="28" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Banco de dados, serviço Windows, migrations e backup" Foreground="#64748B" Margin="0,5,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#E2E8F0" CornerRadius="12" Padding="14,8" VerticalAlignment="Center">
                <TextBlock x:Name="ServiceStatusText" Text="Serviço: verificando..." FontWeight="SemiBold" Foreground="#334155"/>
            </Border>
        </DockPanel>

        <Border Grid.Row="1" Margin="0,24,0,18" Padding="20" Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,14,12">
                    <TextBlock Text="Servidor PostgreSQL" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="HostBox" Height="36" Padding="9,6"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,14,12">
                    <TextBlock Text="Porta" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="PortBox" Height="36" Padding="9,6"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="Banco" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="DatabaseBox" Height="36" Padding="9,6"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,14,12">
                    <TextBlock Text="Usuário" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="UsernameBox" Height="36" Padding="9,6"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="Senha" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="PasswordBox" Height="36" Padding="9,6"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="Porta da API" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="ApiPortBox" Height="36" Padding="9,6"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2">
                    <TextBlock Text="Chave JWT" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="JwtKeyBox" Height="36" Padding="9,6"/>
                </StackPanel>
                <WrapPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,18,0,0">
                    <Button Content="Testar conexão" Height="36" Padding="16,0" Margin="0,0,8,0" Click="TestDb_Click"/>
                    <Button Content="Criar banco" Height="36" Padding="16,0" Margin="0,0,8,0" Click="CreateDb_Click"/>
                    <Button Content="Salvar configuração" Height="36" Padding="16,0" Margin="0,0,8,0" Click="Save_Click"/>
                    <Button Content="Aplicar migrations" Height="36" Padding="16,0" Click="Migrate_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,9,0" Padding="20" Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Serviço Windows" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Executa a API automaticamente ao ligar o servidor." Foreground="#64748B" Margin="0,5,0,18" TextWrapping="Wrap"/>
                    <WrapPanel>
                        <Button Content="Instalar / Iniciar" Height="36" Padding="14,0" Margin="0,0,8,8" Click="Start_Click"/>
                        <Button Content="Parar" Height="36" Padding="14,0" Margin="0,0,8,8" Click="Stop_Click"/>
                        <Button Content="Reiniciar" Height="36" Padding="14,0" Margin="0,0,8,8" Click="Restart_Click"/>
                    </WrapPanel>
                    <Button Content="Criar administrador inicial" Height="38" Margin="0,10,0,0" Click="Bootstrap_Click"/>
                    <Button Content="Inicializar servidor completo" Height="42" Margin="0,8,0,0" Click="Initialize_Click"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Margin="9,0,0,0" Padding="20" Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Backup e restauração" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Backup PostgreSQL no formato custom, adequado ao pg_restore." Foreground="#64748B" Margin="0,5,0,18" TextWrapping="Wrap"/>
                    <Button Content="Criar backup" Height="38" Margin="0,0,0,8" Click="Backup_Click"/>
                    <Button Content="Restaurar backup" Height="38" Click="Restore_Click"/>
                    <TextBlock Text="A restauração substitui objetos existentes. Faça um backup antes." Foreground="#B45309" Margin="0,14,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="0,18,0,0" Background="#0F172A" CornerRadius="12" Padding="14,10">
            <TextBlock x:Name="StatusText" Text="Pronto." Foreground="#E2E8F0" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
